  {
   "say": "Yesterday, how many hours of true focus did you get?",
   "scene": "slam",
   "theme": "dark",
   "transition": "circle",
   "p": {
    "lines": [
     "HOW MANY HOURS",
     "OF TRUE FOCUS?"
